# 语音服务环境变量
#
# 复制为 .env 并填入真实值（.env 已在 .gitignore 里）。
# 全部不配置 = 语音显式未启用，文字操控不受影响。

# —— 豆包 Seed ASR（必需才能启用语音）——

# 火山引擎语音识别资源 ID
DOUBAO_ASR_RESOURCE_ID=

# 鉴权方式二选一：
#   方式 A：只填 API Key
DOUBAO_ASR_API_KEY=
#   方式 B：App Key + Access Key
DOUBAO_ASR_APP_KEY=
DOUBAO_ASR_ACCESS_KEY=

# 可选：自定义端点（默认见 server/asr.ts）
# DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# 可选：热词表 / 纠错表（提升场景专有名词识别率，例如「3号风机」）
# DOUBAO_ASR_HOTWORD_TABLE_ID=
# DOUBAO_ASR_CORRECT_TABLE_ID=

# —— 语音服务自身 ——

# 监听端口，默认 5181
VOICE_PORT=5181

# 可选：访问密钥。配置后浏览器需在 URL 带 ?key=
# VOICE_ACCESS_KEY=

# 可选：额外允许的 Origin，逗号分隔。localhost 永远允许。
# VOICE_ALLOWED_ORIGINS=https://your-site.example.com

# —— 模型意图层（可选）——
#
# 不配置 = 只用规则层，一切照常工作。
# 配置后，规则层听不懂的话（「过去瞅瞅那个风车」）会再问一次模型。
#
# 注意：必须用**非推理**模型。推理模型会把 token 全花在思考上，
# 正文为空、延迟 18~29 秒，做不了 4 秒超时的意图层。

# OpenAI 兼容端点
EMBODIED_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# API Key
EMBODIED_LLM_API_KEY=

# 模型名。推荐非推理的 flash 档，例如 deepseek-v4.1-flash / glm-4.5-flash
EMBODIED_LLM_MODEL=glm-4.5-flash

# 可选：超时毫秒（默认 4000）。快层不能被慢模型拖死。
# EMBODIED_LLM_TIMEOUT_MS=4000
