# 语音服务环境变量
#
# 复制为 .env 并填入真实值（.env 已在 .gitignore 里）。
# 全部不配置 = 语音显式未启用，文字操控不受影响。

# —— 豆包 Seed ASR（必需才能启用语音）——

# 火山引擎语音识别资源 ID
DOUBAO_ASR_RESOURCE_ID=

# 鉴权方式二选一：
#   方式 A：只填 API Key
DOUBAO_ASR_API_KEY=
#   方式 B：App Key + Access Key
DOUBAO_ASR_APP_KEY=
DOUBAO_ASR_ACCESS_KEY=

# 可选：自定义端点（默认见 server/asr.ts）
# DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# 可选：热词表 / 纠错表（提升场景专有名词识别率，例如「3号风机」）
# DOUBAO_ASR_HOTWORD_TABLE_ID=
# DOUBAO_ASR_CORRECT_TABLE_ID=

# 可选：句末静音判定窗口（毫秒），默认 400。
# 调小**不会更快** —— 实测 250 时只出临时结果、永远等不到定稿。
# 想更快只能改交互方式，不能改这个值。
# DOUBAO_ASR_END_WINDOW_MS=400

# —— 语音服务自身 ——

# 监听端口，默认 5181
VOICE_PORT=5181

# 【必填，除非显式允许匿名】语音流访问密钥。
#
# 为什么默认必填：语音流会消耗真金白银的 ASR 额度。以前这里是「空 = 不鉴权」，
# 等于知道地址就能烧钱。现在 key 为空时语音服务直接拒绝所有连接。
# 生成方式：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# 使用方式：浏览器打开 demo 时带上同名参数 —— ?key=你的key
VOICE_ACCESS_KEY=

# 仅本地调试用：显式接受「谁都能连」的风险。生产环境不要开。
# VOICE_ALLOW_ANONYMOUS=1

# 可选：并发上限。每个会话对应一条豆包上游连接（按分钟计费）。
# VOICE_MAX_CONCURRENT=8    # 全局上限
# VOICE_MAX_PER_IP=3        # 单 IP 上限

# 可选：额外允许的 Origin，逗号分隔。localhost 永远允许。
# VOICE_ALLOWED_ORIGINS=https://your-site.example.com

# —— 模型意图层（可选）——
#
# 不配置 = 只用规则层，一切照常工作。
# 配置后，规则层听不懂的话（「过去瞅瞅那个风车」）会再问一次模型。
#
# 注意：必须用**非推理**模型。推理模型会把 token 全花在思考上，
# 正文为空、延迟 18~29 秒，做不了 4 秒超时的意图层。

# OpenAI 兼容端点
EMBODIED_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# API Key
EMBODIED_LLM_API_KEY=

# 模型名。推荐非推理的 flash 档，例如 deepseek-v4.1-flash / glm-4.5-flash
EMBODIED_LLM_MODEL=glm-4.5-flash

# 可选：超时毫秒（默认 800）。
#
# 为什么这么短：实测本机网关上的非推理模型往返 3~4.6 秒，4 秒超时等于
# 「几乎每次都等到超时」，体感是「说完话愣四秒才动」。
# 到模型层的都是规则层听不懂的模糊说法 —— 这类话宁可快速回「没听懂」，
# 也不要把整条链路拖到 4 秒。慢模型/弱网场景可以调大，但会牺牲响应速度。
# EMBODIED_LLM_TIMEOUT_MS=800
