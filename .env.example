# 语音服务环境变量
#
# 复制为 .env 并填入真实值（.env 已在 .gitignore 里）。
# 全部不配置 = 语音显式未启用，文字操控不受影响。

# —— 豆包 Seed ASR（必需才能启用语音）——

# 火山引擎语音识别资源 ID
DOUBAO_ASR_RESOURCE_ID=

# 鉴权方式二选一：
#   方式 A：只填 API Key
DOUBAO_ASR_API_KEY=
#   方式 B：App Key + Access Key
DOUBAO_ASR_APP_KEY=
DOUBAO_ASR_ACCESS_KEY=

# 可选：自定义端点（默认见 server/asr.ts）
# DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# 可选：热词表 / 纠错表（提升场景专有名词识别率，例如「3号风机」）
# DOUBAO_ASR_HOTWORD_TABLE_ID=
# DOUBAO_ASR_CORRECT_TABLE_ID=

# —— 语音服务自身 ——

# 监听端口，默认 5181
VOICE_PORT=5181

# 可选：访问密钥。配置后浏览器需在 URL 带 ?key=
# VOICE_ACCESS_KEY=

# 可选：额外允许的 Origin，逗号分隔。localhost 永远允许。
# VOICE_ALLOWED_ORIGINS=https://your-site.example.com
